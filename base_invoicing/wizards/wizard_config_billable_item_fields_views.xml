<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wizard_config_billable_item_fields_view_form" model="ir.ui.view">
        <field name="name">wizard.config.billable.item.fields.form</field>
        <field name="model">wizard.config.billable.item.fields</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="category_code" invisible="1" />
                    <field name="editable" invisible="1" />

                    <group>
                        <field name="info_billable_item_model_id" readonly="1" />
                        <field
                            name="info_billable_item_quantity_field"
                            readonly="1"
                            modifiers="{'invisible': [['category_code', '=', 1]]}"
                        />
                    </group>

                    <group string="Template for invoice lines"
                        help="Jinja2 template. Use 'billable_item' as variable.">
                        <field name="info_jinja2_shortcuts_help" nolabel="1" widget="html" colspan="2"/>
                        <field
                            name="billable_item_detail_desc"
                            widget="text"
                            rows="4"
                            readonly="1"
                            placeholder="e.g. {{ billable_item.name }} - {{ first_q }} ({{ n_invoiced }})"
                        />
                    </group>

                    <group modifiers="{'invisible': [['editable', '=', false]]}">
                        <separator />
                        <field
                            name="info_billable_item_model_name"
                            invisible="1"
                            modifiers="{}"
                        />
                        <field
                            name="billable_item_group_field_id"
                            options="{'no_create': True}"
                            modifiers="{
                                'invisible': [['category_code', '=', 1]],
                                'readonly': [['editable', '=', false]]
                            }"
                        />
                        <field
                            name="billable_item_domain"
                            widget="domain"
                            nolabel="1"
                            options="{'model': 'info_billable_item_model_name', 'foldable': True}"
                            modifiers="{'readonly': [['editable', '=', false]]}"
                        />
                    </group>
                </group>

                <footer>
                    <button
                        name="set_config_fields"
                        type="object"
                        string="Apply"
                        class="btn-primary"
                        modifiers="{'invisible': [['editable', '=', false]]}"
                    />
                    <button
                        special="cancel"
                        string="Cancel"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>

</odoo>

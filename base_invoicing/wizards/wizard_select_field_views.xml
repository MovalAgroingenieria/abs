<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wizard_select_field_view_form" model="ir.ui.view">
        <field name="name">wizard.select.field.form</field>
        <field name="model">wizard.select.field</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field
                        name="selected_field_id"
                        options="{'no_quick_create': true, 'no_create_edit': true}"
                        required="1"
                    />
                </group>
                <footer>
                    <button
                        name="set_selected_field"
                        type="object"
                        class="btn-primary"
                    />
                    <button
                        special="cancel"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>

</odoo>

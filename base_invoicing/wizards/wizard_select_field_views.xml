<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wizard_select_field_view_form" model="ir.ui.view">
        <field name="name">Wizard to select a field</field>
        <field name="model">wizard.select.field</field>
        <field name="arch" type="xml">
            <form string="Data of the model">
                <script>
                    $(document).ready(function(){
                        $('.modal-dialog').css({'width': '400px'});
                    });
                </script>
                <div>
                    <h4>Field Selection</h4>
                    <hr class="mb-4"/>
                </div>
                <group name="group_field_data">
                    <field name="selected_field_id"
                           string="Field"
                           options="{'no_quick_create':True, 'no_create_edit': True}"
                           required="1"/>
                </group>
                <footer>
                    <button name="set_selected_field"
                            type="object"
                            string="Apply"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-default"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
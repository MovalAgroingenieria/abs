<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="wizard_confirm_productlink_action_view_form" model="ir.ui.view">
        <field name="name">wizard.confirm.productlink.action.form</field>
        <field name="model">wizard.confirm.productlink.action</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="confirm_message" nolabel="1" readonly="1" />

                    <separator />

                    <div class="o_form_label">
                        Proceed with the operation?
                    </div>
                </group>

                <footer>
                    <button name="execute_operation" type="object" class="btn-primary" string="Apply" />
                    <button special="cancel" class="btn-secondary"  string="Cancel" />
                </footer>
            </form>
        </field>
    </record>

</odoo>

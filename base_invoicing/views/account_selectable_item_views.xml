<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_selectable_item_view_tree" model="ir.ui.view">
        <field name="name">account.selectable.item.view.list</field>
        <field name="model">account.selectable.item</field>
        <field name="arch" type="xml">
            <list
                default_order="partner_id, quantity"
                create="false"
                delete="false"
                decoration-info="selected == True and (state == 'draft' or state == 'configured')"
                decoration-muted="selected == False"
                class="o_base_invoicing_account_selectable_item"
                js_class="selectable_item_view_tree"
            >
                <header>
                    <button
                        name="action_select_items"
                        string="Select"
                        type="object"
                        class="btn-secondary"
                        icon="fa-thumbs-o-up"
                    />
                    <button
                        name="action_deselect_items"
                        string="Deselect"
                        type="object"
                        class="btn-secondary"
                        icon="fa-thumbs-o-down"
                    />
                </header>

                <field name="state" invisible="1" />
                <field name="selected" invisible="1" />

                <field
                    name="selected_message"
                    string=" "
                    widget="badge"
                    decoration-info="selected == True"
                    decoration-muted="selected == False"
                    invisible="context.get('hide_selectors', False)"
                />

                <field name="partner_id" string="Customer" />
                <field
                    name="quantity"
                    string="Quantity"
                    sum="Total"
                    invisible="context.get('hide_quantity', False)"
                />
                <!-- Aux columns injected by _get_view from category.aux_field_ids -->
                <field
                    name="rendered_aux_desc"
                    string="Additional Information"
                />
            </list>
        </field>
    </record>

    <record id="account_selectable_item_view_search" model="ir.ui.view">
        <field name="name">account.selectable.item.view.search</field>
        <field name="model">account.selectable.item</field>
        <field name="arch" type="xml">
            <search string="Search items">
                <field name="partner_id" string="Customer" />
                <!-- Aux search fields injected by _get_view -->
                <filter name="selected_yes" string="Selected: Yes" domain="[('selected', '=', True)]" />
                <filter name="selected_no" string="Selected: No" domain="[('selected', '=', False)]" />

                <group expand="0">
                    <filter
                        name="grouped_by_partner_id"
                        string="Customer"
                        context="{'group_by': 'partner_id'}"
                    />
                    <!-- Group-by filters for aux columns injected by _get_view -->
                </group>
            </search>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_invoiceset_view_form" model="ir.ui.view">
        <field name="name">account.invoiceset.view.form</field>
        <field name="model">account.invoiceset</field>
        <field name="arch" type="xml">
            <form duplicate="1" js_class="invoiceset_view_form">
                <header>
                    <button
                        name="calculate_invoiceset"
                        type="object"
                        string="Calculate"
                        class="oe_highlight"
                        data-hotkey="a"
                        modifiers="{'invisible': [['state', '!=', 'configured']]}"
                        confirm="Do you confirm that you want to start the calculation process? If you proceed, the discarded items will no longer be available for selection, although you could recover them by reconfiguring the line."
                    />
                    <button
                        name="cancel_invoices"
                        type="object"
                        string="Cancel"
                        data-hotkey="l"
                        modifiers="{'invisible': [['state', '!=', 'calculated']]}"
                        confirm="Do you confirm that you want to cancel the invoice set and discard the calculation that has been done?"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,configured,calculating,calculated,committed"
                    />
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_show_invoices" type="object" class="oe_stat_button" icon="fa-dollar">
                            <field name="number_of_invoices" string="Invoices" widget="statinfo" />
                        </button>
                        <button name="action_show_invoice_lines" type="object" class="oe_stat_button" icon="fa-list-alt">
                            <field name="number_of_invoice_lines" string="Invoice Lines" widget="statinfo" />
                        </button>
                        <button name="action_show_selectable_items" type="object" class="oe_stat_button" icon="fa-plug">
                            <field name="selectable_item_count" string="Selectable Items" widget="statinfo" />
                        </button>
                    </div>

                    <widget
                        name="web_ribbon"
                        title="IN PROGRESS"
                        bg_color="bg-warning"
                        modifiers="{'invisible': [['state', '!=', 'calculating']]}"
                    />

                    <div class="oe_title">
                        <span class="o_form_label">Code of invoice set</span>
                        <h1>
                            <field
                                name="alphanum_code"
                                style="max-width: 200px"
                                modifiers="{'readonly': [['id', '!=', False]]}"
                            />
                        </h1>
                    </div>

                    <group name="master_data">
                        <group name="master_data_left">
                            <field
                                name="description"
                                string="Description"
                                modifiers="{'readonly': [['state', 'not in', ['draft', 'configured']]]}"
                            />
                            <field
                                name="invoice_date"
                                string="Invoicing Date"
                                modifiers="{'readonly': [['state', 'not in', ['draft', 'configured']]]}"
                            />
                            <field
                                name="invoice_date_due"
                                string="Due Date"
                                modifiers="{'readonly': [['state', 'not in', ['draft', 'configured']]]}"
                            />
                            <field
                                name="payment_term_id"
                                string="Payment Term"
                                modifiers="{'readonly': [['state', 'not in', ['draft', 'configured']]]}"
                                options="{'no_quick_create': True, 'no_create_edit': True}"
                            />
                        </group>

                        <group name="master_data_right">
                            <field
                                name="invoice_user_id"
                                widget="many2one_avatar_user"
                                modifiers="{'readonly': [['state', 'not in', ['draft', 'configured']]]}"
                                options="{'no_quick_create': True, 'no_create_edit': True}"
                            />
                            <field
                                name="journal_id"
                                string="Journal"
                                modifiers="{'readonly': [['state', 'not in', ['draft', 'configured']]]}"
                                options="{'no_quick_create': True, 'no_create_edit': True}"
                                domain="[('type', '=', 'sale')]"
                            />

                            <div
                                name="calculation_progress"
                                class="text-center mb-4"
                                modifiers="{'invisible': [['state', '!=', 'calculating']]}"
                            >
                                <div style="display: inline-block;">
                                    <field name="invoice_generation_progress" widget="progressbar" />
                                </div>
                                <div>
                                    <button
                                        name="stop_calculation"
                                        type="object"
                                        string="Stop Calculation"
                                        class="btn-primary"
                                        icon="fa-hand-paper-o"
                                        confirm="Are you sure you want to stop the calculation?"
                                    />
                                </div>
                            </div>

                            <group
                                name="calculation_info"
                                string="Last calculation"
                                modifiers="{'invisible': ['|', ['state', 'not in', ['calculated', 'committed']], ['calculation_finished_at', '=', False]]}"
                            >
                                <field name="calculation_started_at" />
                                <field name="calculation_finished_at" />
                                <field name="calculation_speed_inv_per_sec" />
                            </group>
                        </group>
                    </group>

                    <notebook name="slave_data_notebook" colspan="4">
                        <page name="page_productlinks" string="Products">
                            <field
                                name="productlink_ids"
                                nolabel="1"
                                modifiers="{'readonly': [['state', 'not in', ['draft', 'configured']]]}"
                            >
                                <list
                                    editable="bottom"
                                    delete="false"
                                    class="o_base_invoicing_account_invoiceset_productlink"
                                >
                                    <field
                                        name="product_id"
                                        string="Product"
                                        domain="[('product_tmpl_id.categ_id.supports_mass_billing', '=', True)]"
                                        options="{'no_quick_create': True, 'no_create_edit': True}"
                                    />
                                    <field name="categ_id" string="Category" />
                                    <field name="lst_price" string="Unit Price" />

                                    <button
                                        name="action_config_billable_item_fields"
                                        title="Configure parameters"
                                        type="object"
                                        class="oe_stat_button"
                                        icon="fa-cog"
                                        modifiers="{'invisible': [['id', '=', False]]}"
                                    />
                                    <button
                                        name="action_show_selectable_items"
                                        title="Show selectable items"
                                        type="object"
                                        class="oe_stat_button"
                                        icon="fa-plug"
                                        modifiers="{'invisible': [['id', '=', False]]}"
                                    />
                                    <button
                                        name="action_refresh_selectable_items"
                                        title="Refresh selectable items"
                                        type="object"
                                        class="oe_stat_button"
                                        icon="fa-refresh"
                                        modifiers="{'invisible': [['id', '=', False]]}"
                                    />
                                    <button
                                        name="action_delete_selectable_items"
                                        title="Delete selectable items"
                                        type="object"
                                        class="oe_stat_button"
                                        icon="fa-eraser"
                                        modifiers="{'invisible': [['id', '=', False]]}"
                                    />

                                    <field name="number_of_selected_items" string="No. of lines" />

                                    <button
                                        name="action_delete_line"
                                        title="Delete this line"
                                        type="object"
                                        class="oe_stat_button"
                                        icon="fa-trash"
                                        modifiers="{'invisible': [['id', '=', False]]}"
                                    />
                                </list>
                            </field>
                        </page>

                        <page name="page_notes" string="Notes">
                            <field name="notes" />
                        </page>

                        <page name="comments" string="Comments">
                            <field
                                name="comment_template_ids"
                                modifiers="{'readonly': [['state', 'not in', ['draft', 'configured']]]}"
                                context="{'default_models': 'account.invoiceset,account.move'}"
                            />
                        </page>
                    </notebook>
                </sheet>

                <chatter />
            </form>
        </field>
    </record>

    <record id="account_invoiceset_view_list" model="ir.ui.view">
        <field name="name">account.invoiceset.view.list</field>
        <field name="model">account.invoiceset</field>
        <field name="arch" type="xml">
            <list
                default_order="alphanum_code desc"
                class="o_base_invoicing_account_invoiceset"
                decoration-info="state == 'draft'"
                decoration-warning="state == 'calculating'"
            >
                <field name="alphanum_code" string="Code" decoration-bf="1" />
                <field name="invoice_date" string="Invoicing Date" />
                <field name="description" string="Description" />
                <field name="invoice_date_due" string="Due Date" widget="remaining_days" />
                <field name="invoice_user_id" string="Sales Person" widget="many2one_avatar_user" optional="show" />
                <field name="payment_term_id" string="Payment Term" optional="hide" />
                <field name="journal_id" string="Journal" optional="hide" />
                <field name="number_of_invoices" string="No. of invoices" optional="show" />
                <field name="calculation_duration_display" string="Calc. time" optional="show" />
                <field
                    name="state"
                    string="Status"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-primary="state == 'configured'"
                    decoration-warning="state == 'calculating'"
                    decoration-muted="state == 'calculated'"
                    decoration-success="state == 'committed'"
                    optional="show"
                />
            </list>
        </field>
    </record>

    <record id="account_invoiceset_view_search" model="ir.ui.view">
        <field name="name">account.invoiceset.view.search</field>
        <field name="model">account.invoiceset</field>
        <field name="arch" type="xml">
            <search string="Search invoice sets">
                <field name="alphanum_code" string="Code" />
                <field name="description" string="Description" />
                <filter name="invoice_date" string="Invoice Date" date="invoice_date" />
                <group expand="0">
                    <filter
                        name="grouped_by_invoice_user_id"
                        string="Sales Person"
                        context="{'group_by': 'invoice_user_id'}"
                    />
                    <filter name="grouped_by_journal_id" string="Journal" context="{'group_by': 'journal_id'}" />
                    <filter
                        name="grouped_by_payment_term_id"
                        string="Payment Term"
                        context="{'group_by': 'payment_term_id'}"
                    />
                    <filter name="grouped_by_state" string="Status" context="{'group_by': 'state'}" />
                    <separator />
                    <filter
                        name="grouped_by_invoice_date"
                        string="Invoicing Date"
                        context="{'group_by': 'invoice_date'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="account_invoiceset_view_kanban" model="ir.ui.view">
        <field name="name">account.invoiceset.view.kanban</field>
        <field name="model">account.invoiceset</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile o_base_invoicing_kanban" sample="1" js_class="account_documents_kanban">
                <field name="alphanum_code" />
                <field name="description" />
                <field name="invoice_date" />
                <field name="state" />
                <field name="invoice_user_id" />
                <field name="number_of_invoices" />
                <field name="invoice_generation_progress" />
                <field name="calculation_duration_display" />
                <field name="calculation_speed_inv_per_sec" />
                <field name="journal_id" />
                <field name="payment_term_id" />
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_base_invoicing_kanban_card"
                             t-att-data-state="record.state.value">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_top_left">
                                    <span class="o_kanban_record_code">
                                        <field name="alphanum_code" />
                                    </span>
                                    <span class="o_kanban_record_status">
                                        <field
                                            name="state"
                                            widget="label_selection"
                                            options="{'classes': {'draft': 'o_kanban_status_draft', 'configured': 'o_kanban_status_configured', 'calculating': 'o_kanban_status_calculating', 'calculated': 'o_kanban_status_calculated', 'committed': 'o_kanban_status_committed'}}"
                                        />
                                    </span>
                                </div>
                                <div class="o_kanban_record_top_right">
                                    <i class="fa fa-calendar-o" aria-label="Date" role="img" title="Date" />
                                    <field name="invoice_date" />
                                </div>
                            </div>
                            <div class="o_kanban_record_desc">
                                <field name="description" />
                            </div>
                            <div class="o_kanban_record_stats">
                                <div class="o_kanban_stat o_kanban_stat_invoices">
                                    <i class="fa fa-file-text-o" aria-label="Invoices" role="img" title="Invoices" />
                                    <strong><field name="number_of_invoices" /></strong>
                                    <span>invoices</span>
                                </div>
                                <t t-if="record.calculation_duration_display.raw_value">
                                    <div class="o_kanban_stat o_kanban_stat_duration">
                                        <i class="fa fa-clock-o" aria-label="Duration" role="img" title="Duration" />
                                        <field name="calculation_duration_display" />
                                    </div>
                                </t>
                                <t t-if="record.calculation_speed_inv_per_sec.raw_value">
                                    <div class="o_kanban_stat o_kanban_stat_speed">
                                        <i class="fa fa-tachometer" aria-label="Speed" role="img" title="Speed" />
                                        <field name="calculation_speed_inv_per_sec" />
                                        <span class="text-muted"> inv/s</span>
                                    </div>
                                </t>
                            </div>
                            <t t-if="record.state.value == 'calculating' and record.invoice_generation_progress.raw_value">
                                <div class="o_kanban_progress_wrapper">
                                    <div class="progress o_kanban_progress">
                                        <div class="progress-bar progress-bar-striped progress-bar-animated"
                                             role="progressbar"
                                             t-attf-style="width: #{record.invoice_generation_progress.raw_value or 0}%"
                                             t-att-aria-valuenow="record.invoice_generation_progress.raw_value"
                                             aria-valuemin="0"
                                             aria-valuemax="100" />
                                    </div>
                                </div>
                            </t>
                            <div class="o_kanban_record_footer">
                                <field name="invoice_user_id" widget="many2one_avatar_user" />
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="account_invoiceset_action" model="ir.actions.act_window">
        <field name="name">Invoice Sets</field>
        <field name="res_model">account.invoiceset</field>
        <field name="view_mode">kanban,list,form</field>
        <field
            name="view_ids"
            eval="[
                (5, 0),
                (0, 0, {'view_mode': 'kanban', 'view_id': ref('account_invoiceset_view_kanban')}),
                (0, 0, {'view_mode': 'list', 'view_id': ref('account_invoiceset_view_list')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('account_invoiceset_view_form')})
            ]"
        />
        <field name="search_view_id" ref="account_invoiceset_view_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new invoice set</p>
        </field>
        <field name="context">{'short_name_categories': True}</field>
    </record>

    <menuitem
        id="account_invoiceset_menu"
        parent="base_invoicing.menu_finance_receivables_massive_invoicing"
        action="account_invoiceset_action"
        sequence="10"
    />

    <record
        id="account_invoiceset_refresh_all_invoicesets_in_calculation_process_serveraction"
        model="ir.actions.server"
    >
        <field name="name">Invoice sets in calculation process stopped (global)</field>
        <field name="model_id" ref="model_account_invoiceset" />
        <field name="state">code</field>
        <field name="groups_id" eval="[(4, ref('base.user_admin'))]" />
        <field name="code">action = env['account.invoiceset'].action_refresh_all_invoicesets_in_calculation_process()</field>
    </record>

    <menuitem
        id="menu_technicalactions_refresh_invoicesets_in_calculation_process"
        parent="menu_technicalactions_refresh"
        action="account_invoiceset_refresh_all_invoicesets_in_calculation_process_serveraction"
        sequence="10"
        groups="base.user_admin"
    />

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_invoiceset_view_form" model="ir.ui.view">
        <field name="name">account.invoiceset.view.form</field>
        <field name="model">account.invoiceset</field>
        <field name="arch" type="xml">
            <form string="Invoice Set" duplicate="0"
                  js_class="invoiceset_view_form">
                <header>
                    <button name="calculate_invoiceset"
                            type="object"
                            string="Calculate"
                            class="oe_highlight"
                            data-hotkey="a"
                            attrs="{'invisible':[('state', '!=', 'configured')]}"
                            confirm="Do you confirm that you want to start the calculation process? If you proceed, the discarded items will no longer be available for selection, although you could recover them by reconfiguring the line."/>
                    <button name="cancel_invoices"
                            type="object"
                            string="Cancel"
                            data-hotkey="l"
                            attrs="{'invisible':[('state', '!=', 'calculated')]}"
                            confirm="Do you confirm that you want to cancel the invoice set and discard the calculation that has been done?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,configured,calculating,calculated,committed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                       <button name="action_show_invoices"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-dollar ">
                            <field string="Invoices"
                                   name="number_of_invoices"
                                   widget="statinfo"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="IN PROGRESS"
                            bg_color="bg-warning"
                            attrs="{'invisible':
                                    [('state', '!=', 'calculating')]}"/>
                    <div class="oe_title">
                        <span class="o_form_label">Code of invoice set</span>
                        <h1>
                            <field name="alphanum_code" style="max-width: 200px"
                                   attrs="{'readonly': [('id', '&gt;', 0)]}"/>
                        </h1>
                    </div>
                    <group name="master_data">
                        <group name="master_data_left">
                            <field name="description" string="Description"
                                   attrs="{'readonly': [('state', '!=', 'draft'), ('state', '!=', 'configured')]}"/>
                            <field name="invoice_date" string="Invoicing Date"
                                   attrs="{'readonly': [('state', '!=', 'draft'), ('state', '!=', 'configured')]}"/>
                            <field name="invoice_date_due" string="Due Date"
                                   attrs="{'readonly': [('state', '!=', 'draft'), ('state', '!=', 'configured')]}"/>
                            <field name="payment_term_id" string="Payment Term"
                                   attrs="{'readonly': [('state', '!=', 'draft'), ('state', '!=', 'configured')]}"
                                   options="{'no_quick_create':True, 'no_create_edit': True}"/>
                        </group>
                        <group name="master_data_right">
                            <field name="invoice_user_id" widget="many2one_avatar_user"
                                   attrs="{'readonly': [('state', '!=', 'draft'), ('state', '!=', 'configured')]}"
                                   options="{'no_quick_create':True, 'no_create_edit': True}"/>
                            <field name="journal_id" string="Journal"
                                   attrs="{'readonly': [('state', '!=', 'draft'), ('state', '!=', 'configured')]}"
                                   options="{'no_quick_create':True, 'no_create_edit': True}"/>
                            <div name="calculation_progress" colspan="2"
                                 class="text-center mb-4"
                                 attrs="{'invisible': [('state', '!=', 'calculating')]}">
                                <div style="display: inline-block;">
                                    <field name="invoice_generation_progress"
                                           widget="progressbar"/>
                                </div>
                                <div>
                                    <button name="stop_calculation"
                                            type="object" string=" Stop Calculation"
                                            class="btn-primary"
                                            icon="fa-hand-paper-o"
                                            confirm="Are you sure you want to stop the calculation?"/>
                                </div>
                            </div>
                        </group>
                    </group>
                    <notebook name="slave_data_notebook" colspan="4">
                        <page name="page_productlinks" string="Products">
                            <field name="productlink_ids" nolabel="1"
                                   attrs="{'readonly': [('state', '!=', 'draft'), ('state', '!=', 'configured')]}">
                                <tree editable="bottom" delete="False"
                                      class="o_base_invoicing_account_invoiceset_productlink">
                                    <field name="product_id" string="Product"
                                           domain="[('product_tmpl_id.categ_id.supports_mass_billing', '=', True)]"
                                           options="{'no_quick_create':True, 'no_create_edit': True}"/>
                                    <field name="categ_id" string="Category"/>
                                    <field name="lst_price" string="Unit Price"/>
                                    <button name="action_config_billable_item_fields"
                                            title="Configure parameters" type="object" class="oe_stat_button"
                                            icon="fa-cog"/>
                                    <button name="action_show_selectable_items"
                                            title="Show selectable items" type="object" class="oe_stat_button"
                                            icon="fa-plug"/>
                                    <button name="action_refresh_selectable_items"
                                            title="Refresh selectable items" type="object" class="oe_stat_button"
                                            icon="fa-refresh"/>
                                    <button name="action_delete_selectable_items"
                                            title="Delete selectable items" type="object" class="oe_stat_button"
                                            icon="fa-eraser"/>
                                    <field name="number_of_selected_items" string="No. of lines"/>
                                    <button name="action_delete_line"
                                            title="Delete this line" type="object" class="oe_stat_button"
                                            icon="fa-trash"/>
                                </tree>
                            </field>
                        </page>
                        <page name="page_notes" string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"
                           widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="account_invoiceset_view_tree" model="ir.ui.view">
        <field name="name">account.invoiceset.view.tree</field>
        <field name="model">account.invoiceset</field>
            <field name="arch" type="xml">
            <tree default_order="alphanum_code desc"
                  class="o_base_invoicing_account_invoiceset"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'calculating'">
                <field name="alphanum_code" string="Code"
                       decoration-bf="1"/>
                <field name="invoice_date" string="Invoicing Date"/>
                <field name="description" string="Description"/>
                <field name="invoice_date_due" string="Due Date"
                       widget="remaining_days"/>
                <field name="invoice_user_id" string="Sales Person"
                       widget="many2one_avatar_user" optional="show"/>
                <field name="payment_term_id" string="Payment Term"
                       optional="hide"/>
                <field name="journal_id" string="Journal"
                       optional="hide"/>
                <field name="number_of_invoices" string="No. of invoices"
                       optional="show"/>
                <field name="state" string="Status"
                       widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-primary="state == 'configured'"
                       decoration-warning="state == 'calculating'"
                       decoration-muted="state == 'calculated'"
                       decoration-success="state == 'committed'"
                       optional="show"/>
            </tree>
        </field>
    </record>

    <record id="account_invoiceset_view_search" model="ir.ui.view">
        <field name="name">account.invoiceset.view.search</field>
        <field name="model">account.invoiceset</field>
        <field name="arch" type="xml">
            <search string="Search invoice sets">
                <field name="alphanum_code" string="Code"/>
                <field name="description" string="Description"/>
                <filter name="invoice_date" string="Invoice Date"
                        date="invoice_date"/>
                <group expand="0">
                    <filter name="grouped_by_invoice_user_id"
                            string="Sales Person"
                     context="{'group_by':'invoice_user_id'}"/>
                    <filter name="grouped_by_journal_id"
                            string="Journal"
                     context="{'group_by':'journal_id'}"/>
                    <filter name="grouped_by_payment_term_id"
                            string="Payment Term"
                     context="{'group_by':'payment_term_id'}"/>
                    <filter name="grouped_by_state"
                            string="Status"
                     context="{'group_by':'state'}"/>
                    <separator/>
                    <filter name="grouped_by_invoice_date"
                            string="Invoicing Date"
                     context="{'group_by':'invoice_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="account_invoiceset_view_kanban" model="ir.ui.view">
        <field name="name">account.invoiceset.view.kanban</field>
        <field name="model">account.invoiceset</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1" js_class="account_documents_kanban">
                <field name="alphanum_code"/>
                <field name="description"/>
                <field name="invoice_date"/>
                <field name="state"/>
                <field name="invoice_user_id"/>
                <field name="number_of_invoices"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="row">
                                <div class="col-6 o_kanban_record_headings">
                                    <strong>
                                        <span>
                                            <field name="alphanum_code"/>
                                        </span>
                                    </strong>
                                </div>
                                <div class="col-6 text-end">
                                    <strong><i class="fa fa-clock-o" aria-label="Date" role="img" title="Date"/> <t t-esc="record.invoice_date.value"/></strong>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    <span><field name="description"/></span>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6">
                                    <span><field name="number_of_invoices" attrs="{'invisible': [('number_of_invoices', '=', 0)]}"/></span><span attrs="{'invisible': [('number_of_invoices', '=', 0)]}"> invoices</span>
                                </div>
                                <div class="col-6 text-end">
                                    <field name="state" widget="label_selection" options="{'classes': {'draft': 'info', 'configured': 'primary', 'calculating': 'warning', 'calculated': 'muted', 'committed': 'success'}}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="account_invoiceset_action" model="ir.actions.act_window">
        <field name="name">Invoice Sets</field>
        <field name="res_model">account.invoiceset</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="view_ids"
         eval="[(5, 0),
                (0, 0, {'view_mode': 'tree',
                        'view_id': ref('account_invoiceset_view_tree')}),
                (0, 0, {'view_mode': 'form',
                        'view_id': ref('account_invoiceset_view_form')}),
                (0, 0, {'view_mode': 'kanban',
                        'view_id': ref('account_invoiceset_view_kanban')})]"/>
        <field name="search_view_id" ref="account_invoiceset_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new invoice set
            </p>
        </field>
        <field name="context">{'short_name_categories': True}</field>
    </record>

    <menuitem id="account_invoiceset_menu"
        parent="base_invoicing.menu_finance_receivables_massive_invoicing"
        action="account_invoiceset_action"
        sequence="10"/>

</odoo>
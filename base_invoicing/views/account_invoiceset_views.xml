<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_invoiceset_view_form" model="ir.ui.view">
        <field name="name">account.invoiceset.view.form</field>
        <field name="model">account.invoiceset</field>
        <field name="arch" type="xml">
            <form string="Invoice Set" duplicate="0">
                <header>
                    <button name="calculate_invoiceset"
                            type="object"
                            string="Calculate"
                            class="oe_highlight"
                            data-hotkey="a"
                            attrs="{'invisible':[('state', '!=', 'configured')]}"/>
                    <button name="cancel_invoiceset"
                            type="object"
                            string="Cancel"
                            data-hotkey="l"
                            attrs="{'invisible':[('state', '!=', 'configured')]}"/>
                    <button name="cancel_invoices"
                            type="object"
                            string="Cancel"
                            data-hotkey="l"
                            attrs="{'invisible':[('state', '!=', 'calculated')]}"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,configured,calculating,calculated,committed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                       <button name="action_show_invoices"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-dollar ">
                            <field string="Invoices"
                                   name="number_of_invoices"
                                   widget="statinfo"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="DRAFT"
                            bg_color="bg-info"
                            attrs="{'invisible':
                                    [('state', '!=', 'draft')]}"/>
                    <div class="oe_title">
                        <span class="o_form_label">Code of invoice set</span>
                        <h1>
                            <field name="alphanum_code" style="max-width: 200px"
                                   attrs="{'readonly': [('id', '&gt;', 0)]}"/>
                        </h1>
                    </div>
                    <group name="master_data">
                        <group name="master_data_left">
                            <field name="description" string="Description"
                                   attrs="{'readonly': [('state', '!=', 'draft'), ('state', '!=', 'configured')]}"/>
                            <field name="invoice_date" string="Invoicing Date"
                                   attrs="{'readonly': [('state', '!=', 'draft'), ('state', '!=', 'configured')]}"/>
                            <field name="invoice_date_due" string="Due Date"
                                   attrs="{'readonly': [('state', '!=', 'draft'), ('state', '!=', 'configured')]}"/>
                            <field name="payment_term_id" string="Payment Term"
                                   attrs="{'readonly': [('state', '!=', 'draft'), ('state', '!=', 'configured')]}"
                                   options="{'no_quick_create':True, 'no_create_edit': True}"/>
                        </group>
                        <group name="master_data_right">
                            <field name="invoice_user_id" widget="many2one_avatar_user"
                                   attrs="{'readonly': [('state', '!=', 'draft'), ('state', '!=', 'configured')]}"
                                   options="{'no_quick_create':True, 'no_create_edit': True}"/>
                            <field name="journal_id" string="Journal"
                                   attrs="{'readonly': [('state', '!=', 'draft'), ('state', '!=', 'configured')]}"
                                   options="{'no_quick_create':True, 'no_create_edit': True}"/>
                        </group>
                    </group>
                    <notebook name="slave_data_notebook" colspan="4">
                        <page name="page_notes" string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"
                           widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="account_invoiceset_view_tree" model="ir.ui.view">
        <field name="name">account.invoiceset.view.tree</field>
        <field name="model">account.invoiceset</field>
            <field name="arch" type="xml">
            <tree default_order="alphanum_code desc"
                  class="o_base_account_invoiceset"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'calculating'">
                <field name="alphanum_code" string="Code"
                       decoration-bf="1"/>
                <field name="invoice_date" string="Invoicing Date"/>
                <field name="description" string="Description"/>
                <field name="invoice_date_due" string="Due Date"
                       widget="remaining_days"/>
                <field name="invoice_user_id" string="Sales Person"
                       widget="many2one_avatar_user" optional="show"/>
                <field name="payment_term_id" string="Payment Term"
                       optional="hide"/>
                <field name="journal_id" string="Journal"
                       optional="hide"/>
                <field name="number_of_invoices" string="No. of invoices"
                       optional="show"/>
                <field name="state" string="State"
                       widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-primary="state == 'configured'"
                       decoration-warning="state == 'calculating'"
                       decoration-muted="state == 'calculated'"
                       decoration-success="state == 'committed'"
                       optional="show"/>
            </tree>
        </field>
    </record>

    <record id="account_invoiceset_view_search" model="ir.ui.view">
        <field name="name">account.invoiceset.view.search</field>
        <field name="model">account.invoiceset</field>
        <field name="arch" type="xml">
            <search string="Search invoice sets">
                <field name="alphanum_code" string="Code"/>
                <field name="description" string="Description"/>
                <group expand="0">
                    <filter name="grouped_by_invoice_user_id"
                            string="Sales Person"
                     context="{'group_by':'invoice_user_id'}"/>
                    <filter name="grouped_by_journal_id"
                            string="Journal"
                     context="{'group_by':'journal_id'}"/>
                    <filter name="grouped_by_payment_term_id"
                            string="Payment Term"
                     context="{'group_by':'payment_term_id'}"/>
                    <filter name="grouped_by_state"
                            string="State"
                     context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="account_invoiceset_action" model="ir.actions.act_window">
        <field name="name">Invoice Sets</field>
        <field name="res_model">account.invoiceset</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids"
         eval="[(5, 0),
                (0, 0, {'view_mode': 'tree',
                        'view_id': ref('account_invoiceset_view_tree')}),
                (0, 0, {'view_mode': 'form',
                        'view_id': ref('account_invoiceset_view_form')})]"/>
        <field name="search_view_id" ref="account_invoiceset_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new invoice set
            </p>
        </field>
    </record>

    <menuitem id="account_invoiceset_menu"
        parent="base_invoicing.menu_finance_receivables_massive_invoicing"
        action="account_invoiceset_action"
        sequence="10"/>

</odoo>

<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="account_invoiceset_view_form" model="ir.ui.view">
        <field name="name">account.invoiceset.view.form</field>
        <field name="model">account.invoiceset</field>
        <field name="arch" type="xml">
            <form duplicate="1">
                <header>
                    <button
                        name="calculate_invoiceset"
                        type="object"
                        string="Calculate"
                        class="oe_highlight"
                        data-hotkey="a"
                        invisible="state not in ('configured', 'error')"
                        confirm="Do you confirm that you want to start the calculation process? If you proceed, the discarded items will no longer be available for selection, although you could recover them by reconfiguring the line."
                    />
                    <button
                        name="cancel_invoices"
                        type="object"
                        string="Cancel"
                        data-hotkey="l"
                        invisible="state not in ('calculated', 'calculating', 'error')"
                        confirm="Do you confirm that you want to cancel the invoice set and discard the calculation that has been done?"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,configured,calculated,committed"
                        readonly="1"
                    />
                    <field name="queue_job_id" invisible="1" />
                </header>                <div class="alert alert-warning text-center" role="alert"
                     invisible="state != 'calculating'">
                    <i class="fa fa-spinner fa-spin me-2"/>
                    Calculation in progress. Please wait until it finishes.
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_show_invoices" type="object" class="oe_stat_button" icon="fa-dollar">
                            <field name="number_of_invoices" string="Invoices" widget="statinfo" />
                        </button>
                        <button
                            name="action_open_queue_job"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-cogs"
                            invisible="not queue_job_id"
                        >
                            <div class="o_stat_info">
                                <field name="invoice_generation_progress" widget="progressbar" class="o_stat_value"/>
                                <span class="o_stat_text">Job</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <span class="o_form_label">Code of invoice set</span>
                        <h1>
                            <field
                                name="alphanum_code"
                                style="max-width: 200px"
                                readonly="id"
                            />
                        </h1>
                    </div>
                    <group name="master_data">
                        <group name="master_data_left">
                            <field
                                name="description"
                                string="Description"
                                readonly="state not in ('draft', 'configured')"
                            />
                            <field
                                name="invoice_type"
                                widget="radio"
                                options="{'horizontal': true}"
                                readonly="state not in ('draft', 'configured')"
                            />
                            <field
                                name="invoice_date"
                                string="Invoicing Date"
                                readonly="state not in ('draft', 'configured')"
                            />
                            <field
                                name="invoice_date_due"
                                string="Due Date"
                                readonly="state not in ('draft', 'configured')"
                            />
                            <field
                                name="payment_term_id"
                                string="Payment Term"
                                readonly="state not in ('draft', 'configured')"
                                options="{'no_quick_create': True, 'no_create_edit': True}"
                            />
                        </group>
                        <group name="master_data_right">
                            <field
                                name="invoice_user_id"
                                widget="many2one_avatar_user"
                                readonly="state not in ('draft', 'configured')"
                                options="{'no_quick_create': True, 'no_create_edit': True}"
                            />
                            <field name="journal_type" column_invisible="1" />
                            <field
                                name="journal_id"
                                string="Journal"
                                readonly="state not in ('draft', 'configured')"
                                options="{'no_quick_create': True, 'no_create_edit': True}"
                                domain="[('type', '=', journal_type)]"
                            />
                        </group>
                    </group>

                    <notebook name="slave_data_notebook" colspan="4">
                        <page name="page_productlinks" string="Products">
                            <field
                                name="productlink_ids"
                                nolabel="1"
                                widget="productlink_section_and_note_one2many"
                                context="{'default_display_type': 'product'}"
                                readonly="state not in ('draft', 'configured')"
                            >
                                <list
                                    editable="bottom"
                                    delete="1"
                                    create="1"
                                    default_order="sequence, id"
                                    string="Lot lines"
                                    decoration-muted="display_type in ('line_section', 'line_note')"
                                    class="o_base_invoicing_account_invoiceset_productlink"
                                >
                                    <control>
                                        <create name="add_line_control" string="Add a line" context="{'default_display_type': 'product'}"/>
                                        <create name="add_section_control" string="Add a section" context="{'default_display_type': 'line_section'}"/>
                                        <create name="add_note_control" string="Add a note" context="{'default_display_type': 'line_note'}"/>
                                    </control>
                                    <field name="sequence" widget="handle"/>
                                    <field name="display_type" column_invisible="1" force_save="1"/>
                                    <field
                                        name="line_name"
                                        widget="list.section_and_note_text"
                                    />
                                    <field
                                        name="product_id"
                                        string="Product"
                                        domain="[('product_tmpl_id.categ_id.supports_mass_billing', '=', True)]"
                                        options="{'no_quick_create': True, 'no_create_edit': True}"
                                        optional="show"
                                    />
                                    <field name="categ_id" string="Category" optional="show"/>
                                    <field name="lst_price" string="Price"/>
                                    <field
                                        name="number_of_selected_items"
                                        string="Nº lines"
                                    />
                                    <button
                                        name="action_config_billable_item_fields"
                                        title="Configure parameters"
                                        type="object"
                                        icon="fa-cog"
                                        invisible="not id or display_type != 'product'"
                                    />
                                    <button
                                        name="action_show_selectable_items"
                                        title="Show selectable items"
                                        type="object"
                                        icon="fa-plug"
                                        invisible="not id or display_type != 'product'"
                                    />
                                    <button
                                        name="action_refresh_selectable_items"
                                        title="Refresh selectable items"
                                        type="object"
                                        icon="fa-refresh"
                                        invisible="not id or display_type != 'product'"
                                    />
                                    <button
                                        name="action_delete_selectable_items"
                                        title="Delete selectable items"
                                        type="object"
                                        icon="fa-eraser"
                                        invisible="not id or display_type != 'product'"
                                    />
                                </list>
                            </field>
                        </page>

                        <page name="page_notes" string="Notes">
                            <field name="notes" />
                        </page>

                        <page name="page_calculation" string="Calculation"
                              invisible="state not in ('calculated', 'committed', 'error') and not last_calculation_error">
                            <group name="calculation_info" string="Last calculation">
                                <group>
                                    <field name="calculation_started_at" />
                                    <field name="calculation_finished_at" />
                                    <field name="calculation_speed_inv_per_sec" />
                                </group>
                            </group>
                            <group name="calculation_error" string="Error details"
                                   invisible="not last_calculation_error">
                                <field name="last_calculation_error" readonly="1" nolabel="1" />
                            </group>
                        </page>
                        <page name="comments" string="Comments">
                            <field
                                name="comment_template_ids"
                                readonly="state not in ('draft', 'configured')"
                                context="{'default_models': 'account.invoiceset,account.move'}"
                            />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="account_invoiceset_view_list" model="ir.ui.view">
        <field name="name">account.invoiceset.view.list</field>
        <field name="model">account.invoiceset</field>
        <field name="arch" type="xml">
            <list
                default_order="alphanum_code desc"
                class="o_base_invoicing_account_invoiceset"
                decoration-info="state == 'draft'"
                decoration-warning="state == 'calculating'"
                decoration-danger="state == 'error'"
            >
                <field name="alphanum_code" string="Code" decoration-bf="1" />
                <field name="invoice_date" string="Invoicing Date" />
                <field name="description" string="Description" />
                <field name="invoice_date_due" string="Due Date" widget="remaining_days" />
                <field name="invoice_user_id" string="Sales Person" widget="many2one_avatar_user" optional="show" />
                <field name="payment_term_id" string="Payment Term" optional="hide" />
                <field name="journal_id" string="Journal" optional="hide" />
                <field name="number_of_invoices" string="No. of invoices" optional="show" />
                <field
                    name="state"
                    string="Status"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-primary="state == 'configured'"
                    decoration-warning="state == 'calculating'"
                    decoration-muted="state == 'calculated'"
                    decoration-success="state == 'committed'"
                    decoration-danger="state == 'error'"
                    optional="show"
                />
            </list>
        </field>
    </record>

    <record id="account_invoiceset_view_search" model="ir.ui.view">
        <field name="name">account.invoiceset.view.search</field>
        <field name="model">account.invoiceset</field>
        <field name="arch" type="xml">
            <search string="Search invoice sets">
                <field name="alphanum_code" string="Code" />
                <field name="description" string="Description" />
                <field name="invoice_user_id" string="Sales Person" />
                <field name="journal_id" string="Journal" />
                <field name="payment_term_id" string="Payment Term" />
                <separator />
                <filter name="filter_state_draft" string="Draft" domain="[('state', '=', 'draft')]" />
                <filter name="filter_state_configured" string="Configured" domain="[('state', '=', 'configured')]" />
                <filter name="filter_state_calculating" string="Calculating" domain="[('state', '=', 'calculating')]" />
                <filter name="filter_state_calculated" string="Calculated" domain="[('state', '=', 'calculated')]" />
                <filter name="filter_state_committed" string="Committed" domain="[('state', '=', 'committed')]" />
                <filter name="filter_state_error" string="Error" domain="[('state', '=', 'error')]" />
                <separator />
                <filter name="filter_my_invoicesets" string="My Invoice Sets" domain="[('invoice_user_id', '=', uid)]" />
                <separator />
                <filter name="invoice_date" string="Invoice Date" date="invoice_date" />
                <filter name="invoice_date_due" string="Due Date" date="invoice_date_due" />
                <group expand="0">
                    <filter
                        name="grouped_by_state"
                        string="Status"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        name="grouped_by_invoice_user_id"
                        string="Sales Person"
                        context="{'group_by': 'invoice_user_id'}"
                    />
                    <filter name="grouped_by_journal_id" string="Journal" context="{'group_by': 'journal_id'}" />
                    <filter
                        name="grouped_by_payment_term_id"
                        string="Payment Term"
                        context="{'group_by': 'payment_term_id'}"
                    />
                    <separator />
                    <filter
                        name="grouped_by_invoice_date"
                        string="Invoicing Date"
                        context="{'group_by': 'invoice_date'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="account_invoiceset_view_kanban" model="ir.ui.view">
        <field name="name">account.invoiceset.view.kanban</field>
        <field name="model">account.invoiceset</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile o_base_invoicing_kanban" sample="1" default_group_by="state">
                <field name="alphanum_code" />
                <field name="description" />
                <field name="invoice_date" />
                <field name="invoice_date_due" />
                <field name="state" />
                <field name="invoice_user_id" />
                <field name="number_of_invoices" />
                <field name="number_of_invoices_draft" />
                <field name="number_of_invoices_posted" />
                <field name="number_of_invoices_cancelled" />
                <field name="number_of_invoice_lines" />
                <field name="selectable_item_count" />
                <field name="productlink_summary" />
                <field name="amount_total_invoices" />
                <field name="amount_total_posted" />
                <field name="company_currency_id" />
                <field name="invoice_generation_progress" />
                <field name="calculation_duration_display" />
                <field name="calculation_speed_inv_per_sec" />
                <field name="journal_id" />
                <field name="payment_term_id" />
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click o_base_invoicing_kanban_card o_kanban_card_state_#{record.state.raw_value or 'draft'}"
                             t-att-data-state="record.state.raw_value">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_top_left">
                                    <span class="o_kanban_record_code">
                                        <field name="alphanum_code" />
                                    </span>
                                    <span class="o_kanban_record_status">
                                        <field
                                            name="state"
                                            widget="label_selection"
                                            options="{'classes': {'draft': 'o_kanban_status_draft', 'configured': 'o_kanban_status_configured', 'calculating': 'o_kanban_status_calculating', 'calculated': 'o_kanban_status_calculated', 'committed': 'o_kanban_status_committed'}}"
                                        />
                                    </span>
                                </div>
                            </div>
                            <div class="o_kanban_record_desc">
                                <field name="description" />
                            </div>
                            <t t-if="record.productlink_summary.raw_value">
                                <div class="o_kanban_record_products small text-muted mb-1">
                                    <i class="fa fa-cube" aria-hidden="true" title="Products"/>
                                    <field name="productlink_summary" nolabel="1"/>
                                </div>
                            </t>
                            <div class="o_kanban_record_dates mb-2">
                                <div class="d-flex justify-content-between small text-muted">
                                    <span><i class="fa fa-calendar" aria-hidden="true" title="Invoice and due date"/> <field name="invoice_date"/> · Due: <field name="invoice_date_due"/></span>
                                </div>
                            </div>
                            <t t-if="record.amount_total_invoices.raw_value">
                                <div class="o_kanban_stat o_kanban_stat_amount mb-2">
                                    <div class="d-flex flex-column gap-1">
                                        <div class="d-flex justify-content-between align-items-center small">
                                            <span class="text-success fw-bold">
                                                <i class="fa fa-check-circle" aria-hidden="true" title="Validated"/> <field name="amount_total_posted" widget="monetary"/>
                                            </span>
                                            <span class="text-muted">/</span>
                                            <span class="fw-bold">
                                                <field name="amount_total_invoices" widget="monetary"/>
                                            </span>
                                            <small class="text-muted">total</small>
                                        </div>
                                        <t t-set="validation_pct" t-value="(record.amount_total_posted.raw_value or 0) / (record.amount_total_invoices.raw_value or 1) * 100"/>
                                        <div class="progress" style="height: 6px;" role="progressbar" t-att-aria-valuenow="validation_pct" aria-valuemin="0" aria-valuemax="100" title="Validation progress">
                                            <div class="progress-bar bg-success" t-attf-style="width: #{validation_pct}%"/>
                                        </div>
                                    </div>
                                </div>
                            </t>
                            <div class="o_kanban_record_stats o_kanban_record_buttons d-flex flex-wrap gap-1 mb-2">
                                <button name="action_show_invoice_lines" type="object" class="btn btn-sm btn-link p-0 text-primary" title="Invoice Lines">
                                    <i class="fa fa-list-alt" aria-hidden="true" title="Invoice Lines"/> <field name="number_of_invoice_lines"/>
                                </button>
                                <button name="action_show_selectable_items" type="object" class="btn btn-sm btn-link p-0 text-primary" title="Selectable Items">
                                    <i class="fa fa-plug" aria-hidden="true" title="Selectable Items"/> <field name="selectable_item_count"/>
                                </button>
                            </div>
                            <t t-if="record.number_of_invoices.raw_value">
                                <div class="o_kanban_record_stats o_kanban_invoice_counts small mb-2 d-flex flex-wrap gap-1 align-items-center">
                                    <t t-if="record.number_of_invoices_draft.raw_value">
                                        <button name="action_show_invoices_pending_validation" type="object" class="btn btn-sm btn-link p-0 text-warning" title="Invoices to Validate">
                                            <i class="fa fa-pencil" aria-hidden="true" title="Draft"/> <field name="number_of_invoices_draft"/> draft
                                        </button>
                                    </t>
                                    <span t-if="record.number_of_invoices_draft.raw_value and record.number_of_invoices_posted.raw_value" class="text-muted">·</span>
                                    <t t-if="record.number_of_invoices_posted.raw_value">
                                        <button name="action_show_invoices_posted" type="object" class="btn btn-sm btn-link p-0 text-success" title="Validated Invoices">
                                            <i class="fa fa-check-square-o" aria-hidden="true" title="Validated"/> <field name="number_of_invoices_posted"/> validated
                                        </button>
                                    </t>
                                    <span t-if="(record.number_of_invoices_draft.raw_value or record.number_of_invoices_posted.raw_value) and record.number_of_invoices_cancelled.raw_value" class="text-muted">·</span>
                                    <t t-if="record.number_of_invoices_cancelled.raw_value">
                                        <button name="action_show_invoices_cancelled" type="object" class="btn btn-sm btn-link p-0 text-muted" title="Cancelled Invoices">
                                            <i class="fa fa-ban" aria-hidden="true" title="Cancelled"/> <field name="number_of_invoices_cancelled"/> cancelled
                                        </button>
                                    </t>
                                </div>
                            </t>
                            <t t-if="record.state.raw_value == 'configured'">
                                <div class="mb-2">
                                    <button
                                        name="calculate_invoiceset"
                                        type="object"
                                        class="btn btn-sm btn-primary"
                                        string="Calculate"
                                        title="Start calculation"
                                        confirm="Do you confirm that you want to start the calculation process?"
                                    >
                                        <i class="fa fa-calculator" aria-hidden="true" title="Calculate"/>
                                    </button>
                                </div>
                            </t>
                            <div class="o_kanban_record_stats">
                                <div class="o_kanban_stat o_kanban_stat_invoices">
                                    <i class="fa fa-files-o" aria-label="Invoices" role="img" title="Invoices" />
                                    <strong><field name="number_of_invoices" /></strong>
                                    <span>invoices</span>
                                </div>
                                <t t-if="record.calculation_duration_display.raw_value">
                                    <div class="o_kanban_stat o_kanban_stat_duration">
                                        <i class="fa fa-clock-o" aria-label="Duration" role="img" title="Duration" />
                                        <field name="calculation_duration_display" />
                                    </div>
                                </t>
                                <t t-if="record.calculation_speed_inv_per_sec.raw_value">
                                    <div class="o_kanban_stat o_kanban_stat_speed">
                                        <i class="fa fa-tachometer" aria-label="Speed" role="img" title="Speed" />
                                        <field name="calculation_speed_inv_per_sec" />
                                        <span class="text-muted"> inv/s</span>
                                    </div>
                                </t>
                            </div>
                            <t t-if="record.state.raw_value == 'calculating' and record.invoice_generation_progress.raw_value">
                                <div class="o_kanban_progress_wrapper">
                                    <div class="progress o_kanban_progress">
                                        <div class="progress-bar progress-bar-striped progress-bar-animated"
                                             role="progressbar"
                                             t-attf-style="width: #{record.invoice_generation_progress.raw_value or 0}%"
                                             t-att-aria-valuenow="record.invoice_generation_progress.raw_value"
                                             aria-valuemin="0"
                                             aria-valuemax="100" />
                                    </div>
                                </div>
                            </t>
                            <div class="o_kanban_record_footer">
                                <field name="invoice_user_id" widget="many2one_avatar_user" />
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="account_invoiceset_action" model="ir.actions.act_window">
        <field name="name">Invoice Sets</field>
        <field name="res_model">account.invoiceset</field>
        <field name="view_mode">list,kanban,form</field>
        <field
            name="view_ids"
            eval="[
                (5, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('account_invoiceset_view_list')}),
                (0, 0, {'view_mode': 'kanban', 'view_id': ref('account_invoiceset_view_kanban')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('account_invoiceset_view_form')})
            ]"
        />
        <field name="search_view_id" ref="account_invoiceset_view_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new invoice set</p>
        </field>
        <field name="context">{'short_name_categories': True}</field>
    </record>

    <menuitem
        id="account_invoiceset_menu"
        parent="base_invoicing.menu_finance_receivables_massive_invoicing"
        action="account_invoiceset_action"
        sequence="10"
    />

</odoo>

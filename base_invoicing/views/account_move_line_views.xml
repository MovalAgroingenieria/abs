<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_move_line_view_tree" model="ir.ui.view">
        <field name="name">account.move.line.view.tree</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="invoiceset_id"/>
                <field name="move_id"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="name"/>
                <field name="quantity"/>
            </tree>
        </field>
    </record>

    <record id="account_move_line_view_search" model="ir.ui.view">
        <field name="name">account.move.line.view.search</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <search string="Search invoice lines">
                <field name="invoiceset_id"/>
                <field name="move_id"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="account_move_line_action" model="ir.actions.act_window">
        <field name="name">Invoice Lines</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">tree</field>
        <field name="view_ids"
         eval="[(5, 0),
                (0, 0, {'view_mode': 'tree',
                        'view_id': ref('account_move_line_view_tree')})]"/>
        <field name="search_view_id" ref="account_move_line_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Invoice Lines
            </p>
        </field>
    </record>

    <menuitem id="account_move_line_menu"
        parent="base_invoicing.menu_finance_receivables_massive_invoicing"
        action="account_move_line_action"
        sequence="20"/>

</odoo>
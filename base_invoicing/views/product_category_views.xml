<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_category_form_view" model="ir.ui.view">
        <field name="name">product.category.form.view.inherit.base_invoicing</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <span attrs="{'invisible': [('category_code', '&lt;', 2)]}"><span>(Category #</span><field name="category_code" nolabel="1"/><span>)</span></span>
                <span attrs="{'invisible': [('category_code', '!=', 1)]}"><span>(Standard Category)</span></span>
            </xpath>
            <xpath expr="//group[@name='first']" position="after">
                    <notebook name="slave_data_notebook" colspan="4">
                        <page name="page_calculation_config" string="Invoice Sets: Calculation Settings">
                            <group name="group_calculation_config">
                                <span name="billable_item_model_id_label" class="o_form_label o_td_label">
                                    Billable items model
                                </span>
                                <div name="div_billable_item_model_id" class="o_address_format"
                                     style="display: flex; gap: 4px;">
                                    <field name="billable_item_model_id"
                                           options="{'no_quick_create':True, 'no_create_edit': True}"
                                           attrs="{'readonly': [('category_code', '=', 1)]}"/>
                                </div>
                                <div class="text-muted mb-4" colspan="2">
                                    Each record in a billable items model contains a potential
                                    reference to an invoice line. The reference to the client
                                    partner on that invoice line is in the "partner_id" field
                                    of the billable items model. If the billable items model is
                                    "res.partner," the reference to the client partner is
                                    the record's "id" (REQUIRED field for batch-based billing).
                                </div>
                                <span name="billable_item_quantity_field_label" class="o_form_label o_td_label"
                                      attrs="{'invisible': [('category_code', '=', 1)]}">
                                    Quantity Field (name / label)
                                </span>
                                <div name="div_billable_item_quantity_field" class="o_address_format"
                                     style="display: flex; gap: 4px;"
                                     attrs="{'invisible': [('category_code', '=', 1)]}">
                                    <field name="billable_item_quantity_field"
                                           style="max-width:150px"/>
                                    <div name="button_billable_item_quantity_field">
                                        <button name="action_select_billable_item_field"
                                                title="Select the quantity field"
                                                type="object" icon="fa-table"
                                                context="{'field': 'billable_item_model_quantity_field',
                                                          'types': 'Integer,Float'}"
                                        />
                                    </div>
                                    <span style="margin-top:3px">/</span>
                                    <field name="billable_item_quantity_label"/>
                                </div>
                                <div class="text-muted mb-4" colspan="2"
                                     attrs="{'invisible': [('category_code', '=', 1)]}">
                                    The billable items model must have a numeric field
                                    ("Integer" or "Float") containing the billable amount.
                                    If this field is not specified, the billable amount
                                    for each record in the billable items model will be
                                    assumed to be 1 (optional field).
                                </div>
                                <span name="billable_item_group_field_label" class="o_form_label o_td_label"
                                      attrs="{'invisible': [('category_code', '=', 1)]}">
                                    Field for grouping
                                </span>
                                <div name="div_billable_item_group_field" class="o_address_format"
                                     style="display: flex; gap: 4px;"
                                     attrs="{'invisible': [('category_code', '=', 1)]}">
                                    <field name="billable_item_group_field"
                                           style="max-width:150px"/>
                                    <div name="button_billable_item_group_field">
                                        <button name="action_select_billable_item_field"
                                                title="Select the field for grouping"
                                                type="object" icon="fa-table"
                                                context="{'field': 'billable_item_model_group_field'}"
                                        />
                                    </div>
                                </div>
                                <div class="text-muted mb-4" colspan="2"
                                     attrs="{'invisible': [('category_code', '=', 1)]}">
                                    If instead of creating one invoice per customer it's necessary
                                    to create an invoice for each combination of customer and another
                                    grouping field, then that additional grouping field must be
                                    specified here (optional field).
                                </div>
                                <span name="billable_item_detail_desc_label" class="o_form_label o_td_label">
                                    Template for invoice lines
                                </span>
                                <div name="div_billable_item_detail_desc" class="o_address_format"
                                     style="display: flex; gap: 4px;">
                                    <field name="billable_item_detail_desc"/>
                                </div>
                                <div class="text-muted mb-4" colspan="2">
                                    The template to be applied for the invoice line description must be
                                    specified here. This is a Jinja2 template. Example: "Annual fee for
                                    member {{billable_item.billing_partner_id.display_name}}" (optional field).
                                    Important: regardless of the billable items model, in the Jinja2 template
                                    we must refer to it as "billable_item".
                                </div>
                                <span name="billable_item_domain_label" class="o_form_label o_td_label">
                                    Pre-filter Condition
                                </span>
                                <div name="div_billable_item_domain" class="o_address_format"
                                     style="display: flex; gap: 4px;">
                                    <field name="billable_item_domain"/>
                                </div>
                                <div class="text-muted mb-4" colspan="2">
                                    Prefilter condition applied to potentially billable items. It uses
                                    SQL-Where syntax. Example (initially include for invoicing only
                                    partners who are neither internal users nor companies):
                                    "partner_share and not is_company".
                                </div>
                            </group>
                        </page>
                        <page name="page_calculation_config" string="Invoice Sets: Selection Settings"
                              attrs="{'invisible': [('billable_item_model_id', '=', False)]}">
                        </page>
                    </notebook>
            </xpath>
        </field>
    </record>

    <record id="product_category_list_view" model="ir.ui.view">
        <field name="name">product.category.list.view.inherit.base_invoicing</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="class">o_base_invoicing_product_category</attribute>
            </xpath>
            <xpath expr="//field[@name='display_name']" position="after">
                <field name="supports_mass_billing"
                       string="Supports Lots"
                       class="text-center"/>
            </xpath>
        </field>
    </record>

    <record id="product_category_search_view" model="ir.ui.view">
        <field name="name">product.category.search.view.inherit.base_invoicing</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <filter name="supports_mass_billing_yes"
                        string="Supports lots: Yes"
                        domain="[('supports_mass_billing', '=', True)]"/>
                <filter name="supports_mass_billing_no"
                        string="Supports lots: No"
                        domain="[('supports_mass_billing', '=', False)]"/>
            </xpath>
        </field>
    </record>

</odoo>
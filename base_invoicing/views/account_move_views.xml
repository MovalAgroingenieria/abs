<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form" model="ir.ui.view">
        <field name="name">view.move.form.inherit.base_invoicing</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="invoiceset_id" string="Invoice Set"
                       readonly="1"
                       attrs="{'invisible': [('move_type', '!=', 'out_invoice')]}"/>
            </xpath>
        </field>
    </record>

    <record id="view_out_invoice_tree" model="ir.ui.view">
        <field name="name">view.out.invoice.tree.inherit.base_invoicing</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="invoiceset_id" string="Invoice Set"
                       optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_filter" model="ir.ui.view">
        <field name="name">view.account.invoice.filter.inherit.base_invoicing</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="invoiceset_id" string="Invoice Set"/>
            </xpath>
            <xpath expr="//filter[@name='to_check']" position="after">
                <separator/>
                <filter string="From invoice set: yes"
                        name="from_invoiceset_yes"
                        domain="[('invoiceset_id', '!=', False)]"/>
                <filter string="From invoice set: no"
                        name="from_invoiceset_no"
                        domain="[('invoiceset_id', '=', False)]"/>
            </xpath>
            <xpath expr="//filter[@name='salesperson']" position="before">
                    <filter name="grouped_by_invoiceset_id"
                            string="Invoice Set"
                     context="{'group_by':'invoiceset_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>
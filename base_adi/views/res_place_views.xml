<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_place_view_form" model="ir.ui.view">
        <field name="name">res.place.view.form</field>
        <field name="model">res.place</field>
        <field name="arch" type="xml">
            <form string="Place" duplicate="false">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <group name="master_data">
                        <group name="master_data_left">
                            <field name="alphanum_code" string="Place"/>
                            <field
                                name="municipality_id"
                                string="Municipality"
                                options="{'no_create': True, 'no_open': True}"
                                readonly="context.get('default_municipality_id', False)"
                            />
                        </group>
                        <group name="master_data_right">
                            <field name="province_id" string="Province" readonly="1"/>
                        </group>
                    </group>
                    <notebook name="slave_data_notebook" colspan="4">
                        <page name="page_notes" string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_place_view_tree" model="ir.ui.view">
        <field name="name">res.place.view.list</field>
        <field name="model">res.place</field>
        <field name="arch" type="xml">
            <list class="o_base_adi_res_place" default_order="province_id, municipality_id, alphanum_code">
                <field name="province_id" string="Province"/>
                <field name="municipality_id" string="Municipality"/>
                <field name="alphanum_code" string="Place"/>
            </list>
        </field>
    </record>

    <record id="res_place_view_search" model="ir.ui.view">
        <field name="name">res.place.view.search</field>
        <field name="model">res.place</field>
        <field name="arch" type="xml">
            <search string="Search places">
                <field name="alphanum_code" string="Place"/>
                <field name="municipality_id" string="Municipality"/>
                <field name="province_id" string="Province"/>
                <field name="region_id" string="Region"/>
                <group expand="0" string="Group By">
                    <filter string="Region" name="grouped_region" context="{'group_by': 'region_id'}"/>
                    <filter string="Province" name="grouped_province" context="{'group_by': 'province_id'}"/>
                    <filter string="Municipality" name="grouped_municipality" context="{'group_by': 'municipality_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="res_place_action" model="ir.actions.act_window">
        <field name="name">Places</field>
        <field name="res_model">res.place</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[
            (ref('base_adi.res_place_view_tree'), 'list'),
            (ref('base_adi.res_place_view_form'), 'form')
        ]"/>
        <field name="search_view_id" ref="base_adi.res_place_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new place
            </p>
            <p>
                Manage places.
            </p>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="res_admregion_view_form" model="ir.ui.view">
        <field name="name">res.admregion.view.form</field>
        <field name="model">res.admregion</field>
        <field name="arch" type="xml">
            <form string="Region" duplicate="false">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_show_provinces"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-sitemap"
                        >
                            <field
                                name="number_of_provinces"
                                string="Provinces"
                                widget="statinfo"
                            />
                        </button>
                    </div>

                    <group name="master_data">
                        <group name="master_data_left">
                            <field name="alphanum_code" string="Region"/>
                        </group>
                        <group name="master_data_right">
                            <div name="flag_image" colspan="2" style="text-align:right;">
                                <field
                                    name="flag_image_256"
                                    class="border"
                                    widget="image"
                                    nolabel="1"
                                    options="{'preview_image': 'flag_image_128'}"
                                    style="width:130px;text-align:center;"
                                />
                            </div>
                        </group>
                    </group>

                    <notebook name="slave_data_notebook" colspan="4">
                        <page name="page_notes" string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_admregion_view_list" model="ir.ui.view">
        <field name="name">res.admregion.view.list</field>
        <field name="model">res.admregion</field>
        <field name="arch" type="xml">
            <list class="o_base_adi_res_admregion" default_order="alphanum_code">
                <field name="flag_image_64" string=" " widget="image" class="text-center"/>
                <field name="alphanum_code" string="Region" class="align-middle"/>
            </list>
        </field>
    </record>

    <record id="res_admregion_view_search" model="ir.ui.view">
        <field name="name">res.admregion.view.search</field>
        <field name="model">res.admregion</field>
        <field name="arch" type="xml">
            <search string="Search regions">
                <field name="alphanum_code" string="Region"/>
            </search>
        </field>
    </record>

    <record id="res_admregion_action" model="ir.actions.act_window">
        <field name="name">Regions</field>
        <field name="res_model">res.admregion</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[
            (ref('base_adi.res_admregion_view_list'), 'list'),
            (ref('base_adi.res_admregion_view_form'), 'form')
        ]"/>
        <field name="search_view_id" ref="base_adi.res_admregion_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new region
            </p>
            <p>
                Manage regions.
            </p>
        </field>
    </record>

</odoo>
